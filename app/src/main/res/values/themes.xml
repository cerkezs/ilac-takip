<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IlacTakip" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>

    <!-- Full screen call theme with translucent status bar and lockscreen show -->
    <style name="Theme.IlacTakip.FullScreenCall" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/call_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
    </style>
</resources>
